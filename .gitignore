.idea
.cache
.vscode
.claude

# A hand-substituted copy, for a build without CMake. CMake writes its own into
# the build tree instead (cmake/config.cmake), so several build trees can share
# this checkout.
include/lh/config.h

build
cmake-build-debug
cmake-build-release

# Per-configuration build trees, named for what they were configured to prove,
# e.g. build-test (with tests) or build-bare (OS off, no libc allocator).
build-*

docs/html
docs/latex

# Python byte cache left by lh_test_css2decl_selftest and any other `python` runner
# that touches scripts/. Without this, the next clean run adds scripts/__pycache__/.
__pycache__