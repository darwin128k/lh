// clang-format off

/**
 * @file config.h
 * @brief Library build configuration (generated from `config.h.in` by CMake).
 *
 * When using **CMake**, reconfigure to refresh this file; do not edit it by hand.
 *
 * **Manual build (no CMake):** copy this file to `config.h` and substitute every
 * CMake-style placeholder (at-sign delimited identifiers) with decimal integers:
 * version macros from the root `VERSION` file; library options use `0` or `1`
 * except `LH_LIBRARY_OPTION_RUNTIME_EXCEPTION_CATCH_STACK_MAX` (must be > 0),
 * `LH_LIBRARY_OPTION_VECTOR_INITIAL_CAPACITY` (must be > 0), and
 * `LH_LIBRARY_OPTION_VECTOR_GROWTH_FACTOR` (must be > 1),
 * `LH_LIBRARY_OPTION_ALGORITHM_COMPARE_BLOCK` (must be > 0); the
 * `LH_LIBRARY_OPTION_MEMORY_ALLOCATOR_DEFAULT_*` trio takes raw
 * C tokens instead (e.g. `malloc`, `free`, `<stdlib.h>`).
 * `LH_LIBRARY_OPTION_SIMD_HAVE_SSE2` / `_SSSE3` / `_AVX2` are toolchain capability probes
 * (see `cmake/check_simd.cmake`) — for a manual build, `0` is always a safe
 * (if slower) default; set `1` only once you have confirmed the toolchain
 * actually compiles that tier's intrinsics for your target.
 *
 * Also defines ::LH_CHAR_BITS (from `CHAR_BIT` in `<limits.h>`) unless you
 * predefine `LH_CHAR_BITS` for a freestanding or unusual toolchain.
 */

#ifndef LH_CONFIG_H
#define LH_CONFIG_H

#include <limits.h>

/**
 * @def LH_CHAR_BITS
 * @brief Bit width of `char` (usually `CHAR_BIT` from `<limits.h>`).
 *
 * Predefine `LH_CHAR_BITS` before including this header 
 * on freestanding or unusual toolchains where `CHAR_BIT` is not provided.
 *
 * @see CHAR_BIT
 */
#ifndef LH_CHAR_BITS
#    ifdef CHAR_BIT
#        define LH_CHAR_BITS CHAR_BIT
#    else
#        error "CHAR_BIT is not defined"
#    endif
#endif

/**
 * @def LH_VERSION_MAJOR
 * @brief Major component of the library version (semantic versioning).
 */
#define LH_VERSION_MAJOR @LH_VERSION_MAJOR@

/**
 * @def LH_VERSION_MINOR
 * @brief Minor component of the library version.
 */
#define LH_VERSION_MINOR @LH_VERSION_MINOR@

/**
 * @def LH_VERSION_PATCH
 * @brief Patch component of the library version.
 */
#define LH_VERSION_PATCH @LH_VERSION_PATCH@

/**
 * @def LH_COMPILE_BY
 * @brief Username of the account that configured/built the project.
 */
#define LH_COMPILE_BY "@LH_COMPILE_BY@"

/**
 * @def LH_COMPILE_HOST
 * @brief Hostname of the machine that configured/built the project.
 */
#define LH_COMPILE_HOST "@LH_COMPILE_HOST@"

/**
 * @def LH_LIBRARY_OPTION_SHARED_BUILD
 * @brief Indicates whether the library is built as a shared object.
 *
 * Value is `1` for shared builds and `0` for static/object builds.
 */
#define LH_LIBRARY_OPTION_SHARED_BUILD @ValShared@

/**
 * @def LH_LIBRARY_OPTION_THREAD_LOCAL
 * @brief Use `thread_local` / `__thread`
 *        for internal state (::LH_LIBRARY_OPTION_OFF / ::LH_LIBRARY_OPTION_ON).
 */
#define LH_LIBRARY_OPTION_THREAD_LOCAL @ValThreadLocal@

/**
 * @def LH_LIBRARY_OPTION_RUNTIME_TERMINATE_USE_STDLIB
 * @brief Default terminate handler uses `abort()`
 *        from the C library (::LH_LIBRARY_OPTION_OFF / ::LH_LIBRARY_OPTION_ON).
 */
#define LH_LIBRARY_OPTION_RUNTIME_TERMINATE_USE_STDLIB @ValRtStdlib@

/**
 * @def LH_LIBRARY_OPTION_MEMORY_ALLOCATOR_USE_STDLIB
 * @brief Default runtime allocator uses `malloc`/`free`
 *        from the C library (::LH_LIBRARY_OPTION_OFF / ::LH_LIBRARY_OPTION_ON).
 */
#define LH_LIBRARY_OPTION_MEMORY_ALLOCATOR_USE_STDLIB @ValAllocatorStdlib@

/**
 * @def LH_LIBRARY_OPTION_MEMORY_ALLOCATOR_DEFAULT_ALLOC
 * @brief Function bound as the default runtime allocator's `alloc_cb`
 *        when ::LH_LIBRARY_OPTION_MEMORY_ALLOCATOR_USE_STDLIB is on (default `malloc`).
 */
#define LH_LIBRARY_OPTION_MEMORY_ALLOCATOR_DEFAULT_ALLOC @ValAllocatorDefaultAlloc@

/**
 * @def LH_LIBRARY_OPTION_MEMORY_ALLOCATOR_DEFAULT_DEALLOC
 * @brief Function bound as the default runtime allocator's `dealloc_cb`
 *        when ::LH_LIBRARY_OPTION_MEMORY_ALLOCATOR_USE_STDLIB is on (default `free`).
 */
#define LH_LIBRARY_OPTION_MEMORY_ALLOCATOR_DEFAULT_DEALLOC @ValAllocatorDefaultDealloc@

/**
 * @def LH_LIBRARY_OPTION_MEMORY_ALLOCATOR_DEFAULT_INCLUDE
 * @brief Header declaring ::LH_LIBRARY_OPTION_MEMORY_ALLOCATOR_DEFAULT_ALLOC
 *        and ::LH_LIBRARY_OPTION_MEMORY_ALLOCATOR_DEFAULT_DEALLOC (default `<stdlib.h>`).
 */
#define LH_LIBRARY_OPTION_MEMORY_ALLOCATOR_DEFAULT_INCLUDE @ValAllocatorDefaultInclude@

/**
 * @def LH_LIBRARY_OPTION_MEMORY_ALLOCATOR_INIT_ALLOCATED
 * @brief Zero-initialize allocated memory in ::lh_memory_allocator_alloc
 *        (::LH_LIBRARY_OPTION_OFF / ::LH_LIBRARY_OPTION_ON).
 */
#define LH_LIBRARY_OPTION_MEMORY_ALLOCATOR_INIT_ALLOCATED @ValAllocatorInitAllocated@

/**
 * @def LH_LIBRARY_OPTION_RUNTIME_EXCEPTION_CATCH_STACK_MAX
 * @brief Maximum depth of nested runtime exception catch frames.
 *
 * Controls internal catch-stack capacity 
 * used by the runtime exception subsystem. 
 * 
 * @note The value must be greater than zero.
 */
#define LH_LIBRARY_OPTION_RUNTIME_EXCEPTION_CATCH_STACK_MAX @ValCatchStackMax@

/**
 * @def LH_LIBRARY_OPTION_VECTOR_INITIAL_CAPACITY
 * @brief Capacity ::lh_vector_t grows to from empty on its first insertion.
 *
 * @note The value must be greater than zero.
 */
#define LH_LIBRARY_OPTION_VECTOR_INITIAL_CAPACITY @ValVectorInitialCapacity@

/**
 * @def LH_LIBRARY_OPTION_VECTOR_GROWTH_FACTOR
 * @brief Factor by which ::lh_vector_t capacity grows once full.
 *
 * @note The value must be greater than one.
 */
#define LH_LIBRARY_OPTION_VECTOR_GROWTH_FACTOR @ValVectorGrowthFactor@

/**
 * @def LH_LIBRARY_OPTION_ALGORITHM_COMPARE_BLOCK
 * @brief Element block size ::lh_algorithm_compare (and the matching fast path in
 *        ::lh_memory_find_step) scans branchlessly before falling back to a precise
 *        scan of the block that turned out to differ/match.
 *
 * @note The value must be greater than zero.
 */
#define LH_LIBRARY_OPTION_ALGORITHM_COMPARE_BLOCK @ValAlgorithmCompareBlock@

/**
 * @def LH_LIBRARY_OPTION_STR_CASE_MAP_USE_TABLE
 * @brief ::lh_str_ptr_to_lower / ::lh_str_ptr_to_upper use a dense 256-entry lookup
 *        table (::LH_LIBRARY_OPTION_ON, O(1), +~400 bytes) instead of binary search
 *        over the sparse pair table (::LH_LIBRARY_OPTION_OFF, O(log n), smaller).
 */
#define LH_LIBRARY_OPTION_STR_CASE_MAP_USE_TABLE @ValStrCaseMapUseTable@

/**
 * @def LH_LIBRARY_OPTION_WSTR_CASE_MAP_USE_TABLE
 * @brief ::lh_wstr_ptr_to_lower / ::lh_wstr_ptr_to_upper use a two-level BMP block
 *        table (::LH_LIBRARY_OPTION_ON, O(1) for the BMP, ~23.5KB) instead of binary
 *        search over the full sparse pair table (::LH_LIBRARY_OPTION_OFF, O(log n),
 *        ~23KB — not really smaller, just simpler lookup code).
 */
#define LH_LIBRARY_OPTION_WSTR_CASE_MAP_USE_TABLE @ValWstrCaseMapUseTable@

/**
 * @def LH_LIBRARY_OPTION_SIMD_HAVE_SSE2
 * @brief Whether this toolchain, for this target, can compile the SSE2 tier used by
 *        ::lh_memory_std_compare / ::lh_memory_std_rcompare (::LH_LIBRARY_OPTION_OFF /
 *        ::LH_LIBRARY_OPTION_ON).
 *
 * Set by a compile-only probe (`cmake/check_simd.cmake`, never executed — safe under
 * cross-compilation) that checks whether the compiler accepts the tier's intrinsics
 * and its runtime CPU-feature-detection mechanism. This is a toolchain *capability*,
 * not a promise that the CPU running the resulting binary has SSE2 — on 32-bit x86
 * that is still checked at runtime before the tier is ever used; on x86-64 SSE2 is
 * part of the baseline ISA and needs no runtime check.
 */
#define LH_LIBRARY_OPTION_SIMD_HAVE_SSE2 @ValSimdHaveSse2@

/**
 * @def LH_LIBRARY_OPTION_SIMD_HAVE_SSSE3
 * @brief Whether this toolchain, for this target, can compile the SSSE3 tier used by
 *        ::lh_memory_std_copy_rev (::LH_LIBRARY_OPTION_OFF / ::LH_LIBRARY_OPTION_ON).
 *
 * Same compile-only probe as ::LH_LIBRARY_OPTION_SIMD_HAVE_SSE2. SSSE3 is never part
 * of any baseline ISA (unlike SSE2 on x86-64), so it is always guarded by a runtime
 * CPU-feature check.
 */
#define LH_LIBRARY_OPTION_SIMD_HAVE_SSSE3 @ValSimdHaveSsse3@

/**
 * @def LH_LIBRARY_OPTION_SIMD_HAVE_AVX2
 * @brief Whether this toolchain, for this target, can compile the AVX2 tier used by
 *        ::lh_memory_std_compare / ::lh_memory_std_rcompare (::LH_LIBRARY_OPTION_OFF /
 *        ::LH_LIBRARY_OPTION_ON).
 *
 * Same compile-only probe as ::LH_LIBRARY_OPTION_SIMD_HAVE_SSE2. AVX2 is never part of
 * any baseline ISA, so it is always guarded by a runtime CPU-feature check regardless
 * of pointer width.
 */
#define LH_LIBRARY_OPTION_SIMD_HAVE_AVX2 @ValSimdHaveAvx2@

#endif /* LH_CONFIG_H */

// clang-format on
